# Estas variables deben cargarse en el entorno del servidor.
# Django no carga automáticamente este archivo.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo true si el proxy de confianza elimina y reescribe X-Forwarded-Proto.
# El backend debe quedar inaccesible directamente desde Internet.
DJANGO_TRUST_PROXY=false
# Los ejemplos solo se permiten con DJANGO_DEBUG=true.
DJANGO_ALLOW_DEMO_DATA=false
# Activar solo tras confirmar HTTPS para todos los subdominios y decidir preload.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
STOREFRONT_URL=https://tu-dominio.cl
STORE_TRANSFER_INSTRUCTIONS=

# Configurar únicamente al disponer de un remitente y proveedor SMTP reales.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
