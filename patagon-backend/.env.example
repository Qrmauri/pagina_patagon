# Estas variables deben cargarse en el entorno del servidor.
# Django no carga automáticamente este archivo.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_CORS_ALLOWED_ORIGINS=
STOREFRONT_URL=https://tu-dominio.cl
STORE_TRANSFER_INSTRUCTIONS=

# Configurar únicamente al disponer de un remitente y proveedor SMTP reales.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
