# Plantilla para incluir dentro del bloque http {} de Nginx en Linux.
# Sustituir dominio, rutas y certificados. Validar con nginx -t antes de usar.
# El backend debe escuchar solo en 127.0.0.1:8000 mediante un servidor WSGI/ASGI.
# No publicar el puerto 8000. No usar runserver en producción.
limit_req_zone $binary_remote_addr zone=patagon_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=patagon_login:10m rate=5r/m;

upstream patagon_backend {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name tienda.example.com;
    return 301 https://tienda.example.com$request_uri;
}

server {
    listen 443 ssl;
    server_name tienda.example.com;
    ssl_certificate /etc/letsencrypt/live/tienda.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tienda.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /srv/patagon/frontend/dist;
    index index.html;
    client_max_body_size 6m;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=3600" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    # Inline CSS es necesario por los estilos React existentes; scripts inline bloqueados.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https: data: blob:; connect-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests" always;

    # Sobrescribir encabezados entrantes, no confiar en los del navegador.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 30s;

    location = /api/auth/login/ {
        limit_req zone=patagon_login burst=5 nodelay;
        proxy_pass http://patagon_backend;
    }
    location /api/ {
        limit_req zone=patagon_api burst=30 nodelay;
        proxy_pass http://patagon_backend;
    }
    location ^~ /media/ {
        alias /srv/patagon/backend/media/;
        autoindex off;
        limit_except GET HEAD { deny all; }
    }
    location ~ /\. { deny all; }
    location / { try_files $uri $uri/ /index.html; }
}
